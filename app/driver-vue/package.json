{
  "name": "driver-vue",
  "version": "1.0.0",
  "description": "Vue for driver application",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "watch": "vite",
    "dev": "vite build --watch --mode development",
    "build:cf": "npm run build && npm run zip",
    "build": "vue-tsc --noEmit && vite build",
    "build:dev": "vue-tsc --noEmit && vite build --mode development",
    "zip": "cd dist/ && npx bestzip driver-vue.zip * ../manifest.json",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage --silent"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0",
    "npm": ">=10"
  },
  "dependencies": {
    "@ui5/webcomponents": "2.12.0",
    "@ui5/webcomponents-base": "2.12.0",
    "@ui5/webcomponents-fiori": "2.12.0",
    "@ui5/webcomponents-icons": "2.12.0",
    "@ui5/webcomponents-icons-business-suite": "2.12.0",
    "@ui5/webcomponents-icons-tnt": "2.12.0",
    "@ui5/webcomponents-localization": "2.12.0",
    "@ui5/webcomponents-theming": "2.12.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vueuse/core": "^13.4.0",
    "cross-fetch": "^4.1.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "odata-query": "8.0.7",
    "pinia": "^3.0.4",
    "vite-plugin-pwa": "^1.3.0",
    "vue": "^3.5.34",
    "vue-cookies": "^1.8.6",
    "vue-i18n": "^11.4.2",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@faker-js/faker": "10.5.0",
    "@pinia/testing": "1.0.3",
    "@testing-library/vue": "8.1.0",
    "@types/leaflet": "1.9.21",
    "@types/leaflet.markercluster": "1.5.6",
    "@vitejs/plugin-vue": "6.0.7",
    "@vitest/coverage-v8": "4.1.8",
    "@vue/tsconfig": "0.7.0",
    "happy-dom": "20.9.0",
    "typescript": "5.8.3",
    "vite": "8.1.0",
    "vitest": "4.1.8",
    "vue-eslint-parser": "10.2.0",
    "vue-tsc": "2.2.12"
  }
}
