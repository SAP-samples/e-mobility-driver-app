{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": [
    "before 5am on friday"
  ],
  "timezone": "Europe/Paris",
  "labels": [
    "dependencies"
  ],
  "constraints": {
    "node": "^22.0.0 || ^24.0.0",
    "npm": ">=10"
  },
  "assignees": [],
  "reviewers": [],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 0,
  "separateMajorMinor": true,
  "separateMultipleMajor": true,
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "description": "Group all @sap packages together",
      "groupName": "SAP packages",
      "matchPackageNames": [
        "@sap/**"
      ]
    },
    {
      "description": "Group all @ui5 packages together",
      "groupName": "UI5 Web Components",
      "matchPackageNames": [
        "@ui5/**"
      ]
    },
    {
      "description": "Group all @types packages together",
      "groupName": "TypeScript types",
      "matchPackageNames": [
        "@types/**"
      ]
    },
    {
      "description": "Group ESLint and related packages",
      "groupName": "ESLint and plugins",
      "matchPackageNames": [
        "/^eslint/",
        "@eslint/**",
        "@typescript-eslint/**"
      ]
    },
    {
      "description": "Group Vue ecosystem packages",
      "groupName": "Vue ecosystem",
      "matchPackageNames": [
        "/^vue/",
        "@vue/**",
        "@vitejs/plugin-vue"
      ]
    },
    {
      "description": "Group Vite and related packages",
      "groupName": "Vite and plugins",
      "matchPackageNames": [
        "/^vite/",
        "/vite-plugin-/"
      ]
    },
    {
      "description": "Group testing packages",
      "groupName": "Testing packages",
      "matchPackageNames": [
        "/^jest/",
        "/^vitest/",
        "@vitest/**",
        "@testing-library/**"
      ]
    },
    {
      "description": "Group SAP Cloud SDK packages",
      "groupName": "SAP Cloud SDK",
      "matchPackageNames": [
        "@sap-cloud-sdk/**"
      ]
    },
    {
      "description": "Automerge minor and patch updates for devDependencies",
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": false
    },
    {
      "description": "Require approval for major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Do not update engines field — ranges must stay compatible with CI containers",
      "matchDepTypes": [
        "engines"
      ],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ],
    "assignees": []
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 5am on monday"
    ]
  },
  "npm": {
    "minimumReleaseAge": "3 days"
  },
  "enabledManagers": [
    "npm",
    "github-actions"
  ],
  "ignoreDeps": [],
  "ignorePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/gen/**",
    "**/mta_archives/**"
  ]
}
